# Copy this file to .env and fill in your PostgreSQL details
# (the same ones you use to connect in pgAdmin).

PGHOST=localhost
PGPORT=5432
PGDATABASE=porridge_factory
PGUSER=postgres
PGPASSWORD=your_password_here

# Set to true if your database requires SSL (most cloud-hosted PostgreSQL does)
PGSSL=false

# Or use one connection string instead of the lines above:
# DATABASE_URL=postgres://user:password@host:5432/porridge_factory

# Port the API server listens on
PORT=4000
